# ==============================================================================
# NYC Citi Bike Lakehouse Pipeline - Environment Configuration
# Copy this file to `.env` and fill in your values (`cp .env.example .env`)
# ==============================================================================

# Execution Mode: "databricks" (AWS S3 + Databricks SQL/Spark) or "local" (Local Parquet/DuckDB for peer review)
PIPELINE_ENV=local

# Citi Bike Dataset Selection
# Format: YYYYMM (e.g., 202401, 202402) and dataset prefix ("JC-" for Jersey City fast ~4MB archives or "" for NYC ~100MB+ archives)
CITIBIKE_YEAR_MONTHS=202401,202402,202403
CITIBIKE_DATASET_PREFIX=JC-
CITIBIKE_SOURCE_BASE_URL=https://s3.amazonaws.com/tripdata

# AWS S3 Data Lake Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=citi-bike-lakehouse-raw-dev
S3_RAW_PREFIX=raw/citibike/tripdata

# Databricks Workspace & Unity Catalog Configuration
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-personal-access-token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0000000000000000
DATABRICKS_CLUSTER_ID=0000-000000-xxxxxxxx
DATABRICKS_CATALOG=citi_bike_catalog
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold

# Local Paths (used when PIPELINE_ENV=local or as staging before S3 upload)
LOCAL_DATA_DIR=./data
